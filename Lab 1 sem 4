import tkinter as tk
from tkinter import messagebox
import math


class MainForm(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Главное окно")
        self.geometry("300x200")

        self.update_idletasks()
        width = self.winfo_width()
        height = self.winfo_height()
        x = (self.winfo_screenwidth() // 2) - (width // 2)
        y = (self.winfo_screenheight() // 2) - (height // 2)
        self.geometry(f'{width}x{height}+{x}+{y}')

        self.button1 = tk.Button(self, width=12, height=2)
        self.button1.place(x=50, y=50)

        self.button2 = tk.Button(self, width=12, height=2)
        self.button2.place(x=160, y=50)

        self.button1.bind("<Enter>", lambda e: self.on_mouse_enter(self.button1))
        self.button1.bind("<Leave>", lambda e: self.on_mouse_leave(self.button1))
        self.button1.config(command=self.show_number_input_window)

        self.button2.bind("<Enter>", lambda e: self.on_mouse_enter(self.button2))
        self.button2.bind("<Leave>", lambda e: self.on_mouse_leave(self.button2))
        self.button2.config(command=self.show_number_input_window)

    def on_mouse_enter(self, button):
        button.config(text="пришел")

    def on_mouse_leave(self, button):
        button.config(text="Ушел")

    def show_number_input_window(self):
        input_window = tk.Toplevel(self)
        input_window.title("Ввод числа")
        input_window.geometry("300x150")
        input_window.resizable(False, False)

        input_window.transient(self)
        input_window.grab_set()

        input_box = tk.Entry(input_window, width=30)
        input_box.place(x=20, y=20)
        input_box.focus()

        result_label = tk.Label(input_window, text="Введите число и нажмите Enter")
        result_label.place(x=20, y=50)

        def on_enter_pressed(event):
            input_text = input_box.get().strip()

            try:
                input_text = input_text.replace(',', '.')
                number = float(input_text)

                cube = math.pow(number, 3)
                result_label.config(text=f"Результат: {cube} (куб числа {number})")

            except ValueError:
                messagebox.showwarning(
                    "Ошибка ввода",
                    "Пожалуйста, введите корректное число.\n"
                    "Примеры: 5, -3.14, 2e3 (это 2000), 1.5e-2 (это 0.015)"
                )
                result_label.config(text="Введите число и нажмите Enter")

        input_box.bind('<Return>', on_enter_pressed)


def main():
    app = MainForm()
    app.mainloop()


if __name__ == "__main__":
    main()
